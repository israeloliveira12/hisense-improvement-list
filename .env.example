# Senha unica compartilhada pra entrar no site (gate simples, sem login individual).
SITE_PASSWORD=troque-esta-senha

# --- Google Sheets / Drive (Fase 2) ---------------------------------------
# Vem do JSON da service account (Google Cloud > IAM > Contas de servico > Chaves).
# client_email do JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=site-hisense-improvement@hisense-improvement-list.iam.gserviceaccount.com
# private_key do JSON -- cole o valor inteiro, incluindo BEGIN/END PRIVATE KEY.
# Na Vercel, cole exatamente como esta no JSON (com \n literais) -- o codigo
# ja converte pra quebra de linha de verdade sozinho.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da planilha (esta na URL: /d/<ESTE_TRECHO>/edit)
GOOGLE_SHEET_ID=1SoK5AjfSUqI1XxHibq-nufrTKADgdRxVGFO5srXcehQ

# ID da pasta "Evidencias" no Drive
GOOGLE_DRIVE_FOLDER_ID=1OI0RTwQ_nPxMu-z8rzcbWJAc8YCKOMvG
